# Copy this file to .env and adjust the values for your machine.

# HTTP + WebSocket port of the API server
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacy_ims

# Secret used to sign JSON Web Tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Origin of the React dev server (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Base URL of the Python forecasting microservice
ML_SERVICE_URL=http://127.0.0.1:5001

# Cron schedule for the background reorder-alert check (default: every hour)
FORECAST_CRON=0 * * * *

# Outgoing email, used to send password reset links. Leave SMTP_HOST empty
# and no email is sent. Any SMTP account works; for Gmail, turn on 2-step
# verification and create an App Password (Google Account > Security > App
# passwords), then use: smtp.gmail.com, port 587, your address and that
# 16-character password. Port 465 uses TLS from the start; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender as recipients see it, e.g.  Pharmacy IMS <your-address@gmail.com>
MAIL_FROM=
# Only for a local mail catcher such as Mailpit (smtp on localhost:1025):
# SMTP_REQUIRE_TLS=false

# Password reset, development: with this true (and NODE_ENV not "production")
# the server also prints each reset link to its console, mail or no mail.
AUTH_RESET_DEBUG=false

# Folder for chat image attachments (created at startup if missing). Relative
# paths are resolved from where the server is started. Default: server/uploads
# UPLOADS_DIR=./uploads
