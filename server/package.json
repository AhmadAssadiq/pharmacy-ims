{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Pharmacy IMS - Node.js REST API + WebSocket chat server",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "db:migrate": "node --env-file=.env src/db/migrate.js",
    "db:seed": "node --env-file=.env src/db/seed.js",
    "forecast": "node --env-file=.env src/jobs/runForecastOnce.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "ws": "^8.18.0"
  }
}
